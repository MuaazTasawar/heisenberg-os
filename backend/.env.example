# Copy to backend/.env (git-ignored). The fix-up setup script creates it for you.

# development | production  (production => gin release mode, strict checks)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/heisenberg_os?sslmode=disable

# --- auth ---------------------------------------------------------------
# REQUIRED, at least 32 characters:  openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=72
# Set to true when the API is served over HTTPS (marks the cookie Secure)
COOKIE_SECURE=false

# --- network --------------------------------------------------------------
# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse-proxy IPs to trust for X-Forwarded-For (comma separated, empty = none)
TRUSTED_PROXIES=

# --- ML microservice ------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
# Must equal the ML service's ML_API_KEY. Empty = no key sent (local dev).
ML_API_KEY=
ML_TIMEOUT_MS=1500

# --- Saul Goodman (Anthropic) ---------------------------------------------
# Optional. Without a key /legal/consult answers 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SEC=25

# --- rate limits (requests per minute, per client IP) ---------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_LEGAL_PER_MIN=5
RATE_LIMIT_API_PER_MIN=240
