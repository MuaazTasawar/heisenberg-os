# Copy to .env (git-ignored). Read by docker-compose.yml.
# The fix-up setup script creates .env for you with fresh secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=heisenberg_os

# At least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Shared secret between the Go API and the ML service.
# Leave empty to disable the check (local development only).
ML_API_KEY=

# Saul Goodman (optional - /legal/consult answers 503 without a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true when the API is served over HTTPS
COOKIE_SECURE=false

# Baked into the web build
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
